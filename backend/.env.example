# ===========================================================================
# DataSentinel 2.0 Environment Configuration
# Nebius x NVIDIA Global AI Hackathon
# ===========================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true

# Nebius Token Factory Configuration
# Obtain your API key from the Nebius Token Factory / Studio dashboard
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Set to true to force offline synthetic Nemotron mock mode (default if no API key is provided)
MOCK_MODE=false

# SQLite Persistence Path
DATABASE_PATH=datasentinel.db

# Dataset Upload Storage Directory
DATASET_STORAGE_DIR=../sample-data/datasets

# Investigation Concurrency & Safety Caps
MAX_INVESTIGATION_CONCURRENCY=4
MAX_INVESTIGATION_STEPS=6
MAX_TOOL_ROWS=25
INVESTIGATION_TIMEOUT_SECONDS=120
MAX_JOB_RETRIES=2
